{
  "name": "@morphcloud/client",
  "version": "0.1.2",
  "description": "Browser and Node client for the Morphcloud Navigator API: sign-in, envelopes, workspaces, tables and live updates.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morph-cloud/morphcloud-client.git"
  },
  "homepage": "https://github.com/morph-cloud/morphcloud-client#readme",
  "bugs": {
    "url": "https://github.com/morph-cloud/morphcloud-client/issues"
  },
  "keywords": [
    "morphcloud",
    "navigator",
    "lovable",
    "client",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
